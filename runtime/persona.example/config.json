{
  "_note": "运行时的配置文件模板。复制本目录为 persona/ 后按需修改；改这里不需要动代码。",

  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "open_browser": true
  },

  "llm": {
    "provider": "openai_compatible",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "model": "glm-4-flash",
    "api_key_env": "XIYU_API_KEY",
    "temperature": 0.85,
    "max_tokens": 160,
    "timeout": 30,
    "note": "任何 OpenAI 兼容接口都能用。DeepSeek：https://api.deepseek.com/v1；本地 Ollama：http://127.0.0.1:11434/v1 + 模型 qwen2.5:7b。Key 也可以直接在网页顶部粘贴，会存到 persona/llm-key.txt。"
  },

  "tts": {
    "engine": "f5-tts",
    "_note": "engine 可选 f5-tts（零样本，装完即用）或 gpt-sovits（需自己微调出专属模型，并额外启动 9880 语音服务）。",

    "api": "http://127.0.0.1:9880",
    "text_lang": "zh",
    "split_method": "cut5",
    "speed_factor": 1.0,
    "seed": 42,
    "ref_free": false,
    "_ref_free_note": "true = 只用训练出的声线，不喂参考音频；false = 用参考音频定音色。仅 gpt-sovits 生效。",
    "repetition_penalty": 1.35,
    "top_k": 15,
    "top_p": 1.0,
    "temperature": 1.0,
    "timeout": 120,

    "f5": {
      "model": "F5TTS_v1_Base",
      "device": "cuda",
      "nfe_step": 32,
      "cfg_strength": 2.0,
      "speed": 0.9,
      "remove_silence": true
    }
  },

  "retrieval": {
    "method": "keyword",
    "top_k": 2,
    "min_score": 1
  },

  "memory": {
    "enabled": true,
    "file": "persona/memory-log.md",
    "write_after_turns": 1
  }
}
